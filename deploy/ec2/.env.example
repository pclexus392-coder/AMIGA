# Copy ONLY on the EC2 server to /etc/amiga/amiga.env (root:amiga, mode 0640).
# The localhost backend/.env and its AWS keys must never be copied here.
AMIGA_ENV=production
AMIGA_ENV_FILE=/etc/amiga/amiga.env
PUBLIC_BASE_URL=https://CHANGE_ME
SECRET_KEY=
DATABASE_URL=
UPLOAD_DIR=/var/lib/amiga/documents
AUTH_METHOD=local_password
ADMIN_BOOTSTRAP_EMAIL=
SESSION_HOURS=8
AWS_REGION=us-east-1
AI_PROVIDER=bedrock
BEDROCK_MODEL_ID=us.amazon.nova-lite-v1:0
# Deliberately nonexistent files prevent picking up shared credentials/profiles.
AWS_CONFIG_FILE=/etc/amiga/role-only.config
AWS_SHARED_CREDENTIALS_FILE=/etc/amiga/role-only.credentials
OPENAI_MODEL=gpt-6-luna
AGENT_MODEL=gpt-6-luna
AGENT_DAILY_LIMIT=60
OPENAI_API_KEY_FILE=/etc/amiga/openai.key
START_QUEUE_WORKER=1
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
